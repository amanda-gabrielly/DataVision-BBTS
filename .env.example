# Copie para .env (que NÃO vai para o Git) e ajuste.

# --- Banco (PostgreSQL) ---
# Local com docker compose (padrão):
DATABASE_URL=postgresql+psycopg://datavision:datavision@localhost:5432/datavision
# Banco compartilhado/online (Neon, Supabase, RDS...): cole a URL aqui; postgres:// e postgresql:// também funcionam.
# DATABASE_URL=postgresql://usuario:senha@host:5432/datavision?sslmode=require
POSTGRES_PASSWORD=datavision

# --- IA (Amazon Bedrock) ---
# auto    = usa o Bedrock se houver credenciais AWS, senão modo offline (busca textual, sem custo)
# bedrock = exige o Bedrock
# offline = nunca chama a AWS (bom para desenvolver o front sem gastar)
AI_MODE=auto
AWS_REGION=us-east-1
# Credenciais: use `aws configure` ou as variáveis abaixo. NUNCA versionar chaves.
# Se a AWS entregou uma "chave de API do Bedrock" (um token único), use só esta linha:
# AWS_BEARER_TOKEN_BEDROCK=
# Se entregou Access Key + Secret (e às vezes Session Token), use estas:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
BEDROCK_GENERATION_MODEL=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL=cohere.embed-multilingual-v3

# --- Login ---
# DEMO_MODE=1: cria 5 contas de exemplo (uma por perfil) e mostra atalhos na tela de login. Use na apresentação.
# Em produção: DEMO_MODE=0 e crie usuários reais com `python -m scripts.criar_usuario`.
DEMO_MODE=1
DEMO_PASSWORD=datavision@2026
SESSAO_HORAS=12

# --- Outros ---
TOP_K=8
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
